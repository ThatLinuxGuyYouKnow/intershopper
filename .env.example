# ---------------------------------------------------------------------------
# Intershopper environment
# Copy to .env.local for local dev (already done for you in this repo),
# and set the same values in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# "sandbox" (test) or "production" (live money)
INTERSWITCH_ENV=sandbox

# From Quickteller Business → Developer Tools → Integration Credentials.
# The values below are the public TEST credentials published in Interswitch's
# docs (Default Test Credentials) — they work against the sandbox immediately.
INTERSWITCH_CLIENT_ID=IKIAB23A4E2756605C1ABC33CE3C287E27267F660D61
INTERSWITCH_SECRET_KEY=secret
INTERSWITCH_MERCHANT_CODE=MX6072
INTERSWITCH_PAYABLE_CODE=9405967

# Optional URL overrides (defaults follow INTERSWITCH_ENV)
# INTERSWITCH_PASSPORT_URL=
# INTERSWITCH_PAYBILL_URL=
# INTERSWITCH_STATUS_URL=

# Database — SQLite locally, Turso (hosted SQLite) on Vercel.
# Local dev falls back to ./data/intershopper.db when unset.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Public origin of this app (used for the post-payment redirect URL).
# Defaults to the request origin when unset — set it in production.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
